# Runtime
APP_ENV=development
APP_NAME=nba-scout-assistant
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Security
API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Data sources
NBA_API_KEY=
NBA_STATS_BASE_URL=https://stats.nba.com
BASKETBALL_REFERENCE_BASE_URL=https://www.basketball-reference.com
DATA_AS_OF_DATE=2026-02-01

# Local paths
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed
FEATURE_STORE_DIR=data/features
MODEL_ARTIFACT_DIR=models
REPORTS_DIR=reports

# Database
DATABASE_URL=postgresql+psycopg://nba_scout:nba_scout@localhost:5432/nba_scout

# MLflow and model registry
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=nba-scout-recommendations
MODEL_REGISTRY_URI=file:./models

# Recommendation defaults
DEFAULT_TOP_K=5
DEFAULT_STRATEGY=BALANCED
DEFAULT_MAX_ANNUAL_SALARY_USD=
DEFAULT_MIN_CONFIDENCE=0.60

# Feature and model versions for auditability
FEATURE_VERSION=v0.1.0
ROLE_SIMILARITY_MODEL_VERSION=baseline-v0.1.0
PERFORMANCE_FORECAST_MODEL_VERSION=baseline-v0.1.0
SALARY_MODEL_VERSION=baseline-v0.1.0
RANKING_MODEL_VERSION=baseline-v0.1.0
